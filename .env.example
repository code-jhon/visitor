# Visitor — example environment variables (copy to .env per app/environment)
# Backend (apps/api)
ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://visitor:visitor@localhost:5432/visitor
SECRET_KEY=change-me-in-each-environment
ALLOWED_ORIGINS=http://localhost:5173
AWS_REGION=us-east-1
S3_BUCKET=visitor-dev-files
# Auth / RBAC (VIS-2)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_EXPIRE_MINUTES=30
SEED_ADMIN_EMAIL=admin@visitor.app
SEED_ADMIN_PASSWORD=change-me-admin

# Web (apps/web)
VITE_API_BASE_URL=http://localhost:8000

# Mobile (apps/mobile)
API_BASE_URL=http://localhost:8000
